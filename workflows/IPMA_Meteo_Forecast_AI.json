    {
      "parameters": {
        "mode": "combineBySql",
        "numberInputs": 5,
        "query": "SELECT\n  input3.precipitaProb\n  , input3.tMin AS minimum_temperature\n  , input3.tMax AS maximum_temperature\n  , input2.descWeatherTypeEN\n  , input1.local\n  , input4.descClassWindSpeedDailyEN\n  , input5.items AS weather_warnings\nFROM input3\nLEFT JOIN\n  input2\n  ON input2.idWeatherType = input3.idWeatherType\nLEFT JOIN\n  input1\n  ON input1.globalIdLocal = input3.globalIdLocal\nLEFT JOIN\n  input4\n  ON input4.classWindSpeed = input3.classWindSpeed\nLEFT JOIN\n  input5\n  ON input5.idAreaAviso = input1.idAreaAviso",
        "options": {}
      },
