      "id": "ea122710-b6c2-4d2b-8f8f-c9bdf8df3e00",
      "name": "Remove green warnings"
    },
    {
      "parameters": {
        "jsCode": "const grouped = {};\n\nfor (const item of items) {\n  const key = item.json.idAreaAviso;\n\n  if (!grouped[key]) {\n    grouped[key] = [];\n  }\n\n  grouped[key].push(item.json);\n}\n\nreturn Object.entries(grouped).map(([key, value]) => ({\n  json: {\n    idAreaAviso: key,\n    items: value,\n  },\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
